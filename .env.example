# Stroke Multimodal Prognosis — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env, fill in your values, then install python-dotenv so
# the scripts can load it automatically:
#
#   pip install python-dotenv
#   cp .env.example .env
#   # edit .env with your real values
#
# NEVER commit .env to version control — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Keys ─────────────────────────────────────────────────────────────────
# Alibaba DashScope (Qianwen / Tongyi) key — used by pre/generate_text_qianwen.py
# to generate radiology text from MRI PNGs via the qwen-vl-max model.
# Obtain at: https://dashscope.aliyun.com/
QIANWEN_API_KEY=your_qianwen_api_key_here

# Hugging Face token — required to download gated models (MedGemma-4B-IT).
# Used by pre/generate_text_medgemma.py and pre/download_medgemma.py.
# Obtain at: https://huggingface.co/settings/tokens
# Accept the MedGemma licence at: https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=your_huggingface_token_here

# ── Raw Data Paths (pre-processing — Step 1) ─────────────────────────────────
# Directory containing one raw NIfTI file (.nii or .nii.gz) per patient.
RAW_NII_DIR=E:/data/image_mri_data

# Output directory where axial / coronal / sagittal PNG slices will be saved,
# one sub-folder per patient (created by pre/extract_mri_slices.py).
MRI_SLICES_DIR=E:/data/image_mri

# Output directory for Qianwen-generated text descriptions (.txt, one per patient).
TEXT_QIANWEN_DIR=E:/data/text_data_by_qianwen

# Output directory for MedGemma-generated text descriptions (severe cases).
TEXT_MEDGEMMA_DIR=E:/data/text_data_by_medgemma

# ── Pre-trained Model Weights (encoding — Step 2) ────────────────────────────
# Path to the MedicalNet ResNet-50 checkpoint file (.pth).
# Download: https://github.com/Tencent/MedicalNet  →  resnet_50_23dataset.pth
MEDICALNET_WEIGHTS=E:/pretrained/resnet_50_23dataset.pth

# Local directory for cached BioBERT weights.
# Auto-downloaded from HuggingFace (monologg/biobert_v1.1_pubmed) on first run.
BIOBERT_MODEL_DIR=E:/pretrained/biobert_v1.1_pubmed

# Local directory for cached MedGemma-4B-IT weights.
# Auto-downloaded from HuggingFace (google/medgemma-4b-it) on first run.
# Requires HF_TOKEN and model licence acceptance.
MEDGEMMA_MODEL_DIR=E:/pretrained/medgemma-4b-it

# ── Raw Clinical / Tabular Data (encoding — Step 2) ─────────────────────────
# Path to the raw clinical Excel file.
# Expected columns: id (col 0), clinical features (cols 1…-2), label (last col).
CLINIC_RAW_PATH=E:/data/clinic_data.xlsx

# ── Encoded Feature Output Paths (Step 2 outputs → Step 3 inputs) ────────────
# These default to  stroke_multimodal_prognosis/data/encoded/
# Override only if you want to store the feature Excel files elsewhere.
#
# IMAGE_FEATURE_OUTPUT=stroke_multimodal_prognosis/data/encoded/image_feature.xlsx
# TEXT_FEATURE_OUTPUT=stroke_multimodal_prognosis/data/encoded/medical_text_features_by_qianwen_best.xlsx
# CLINIC_ENCODED_OUTPUT=stroke_multimodal_prognosis/data/encoded/clinic_data_1.xlsx
